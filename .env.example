# Application
APP_NAME=Document Intelligence RAG API
APP_VERSION=0.2.0
ENVIRONMENT=development
DEBUG=false
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8000

# MongoDB: local host port mapped to container port 27017
MONGO_HOST=127.0.0.1
MONGO_PORT=27018
MONGO_DATABASE=rag_db
MONGO_APP_USERNAME=rag_app
MONGO_APP_PASSWORD=replace_with_your_local_app_password
MONGO_AUTH_SOURCE=rag_db

# Qdrant
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=document_chunks

# FastEmbed multilingual model (384 dimensions)
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSIONS=384

# Local storage and chunking
STORAGE_DIR=assets/uploads
MAX_UPLOAD_SIZE_MB=25
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=5

# Optional OpenAI-compatible generation. If no key is configured,
# /query returns retrieved context without generated prose.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=45
